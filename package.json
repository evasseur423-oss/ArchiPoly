{
  "name": "archipoly",
  "productName": "ArchiPoly",
  "appId": "com.archipoly.app",
  "version": "1.0.0",
  "description": "ArchiPoly — Suite Logicielle 3D d'Architecture & d'Ingénierie",
  "main": "main.js",
  "scripts": {
    "start": "electron main.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win --x64",
    "server": "node server.js"
  },
  "keywords": [
    "architecture",
    "3d",
    "threejs",
    "pbr",
    "materials",
    "slicer",
    "fabrication",
    "engineering",
    "physics",
    "electron"
  ],
  "author": "ArchiPoly Contributors",
  "license": "GPL-3.0-only",
  "dependencies": {
    "express": "^5.2.1",
    "jszip": "^3.10.2",
    "multer": "^2.4.0",
    "three": "0.165.0"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.archipoly.app",
    "productName": "ArchiPoly",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ArchiPoly"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.exe"
    },
    "files": [
      "**/*",
      "!dist/**",
      "!**/*.bat",
      "!temp_uploads/**",
      "!PBR visualizer/public/materials/**",
      "!Workspace_Materials/**",
      "!3D viewer app/**",
      "!ArchPhysics Studio/**",
      "!Maquette Slicer Studio/**",
      "!PBR Alchemist/**",
      "!PBR visualizer/**"
    ]
  }
}